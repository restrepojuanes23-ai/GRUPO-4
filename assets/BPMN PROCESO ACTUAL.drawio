tyle="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="924" y="375" width="24" height="20" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Puntos críticos&lt;/b&gt;&lt;br&gt;PC1 · Guardado en cajas y bolsas sueltas: los anillos se desordenan y se pierden.&lt;br&gt;PC2 · Exhibición en el mostrador: sin soporte propio, la presentación es poco atractiva y depende de la administradora.&lt;br&gt;PC3 · Búsqueda manual entre cajas y bolsas: se demora la atención al cliente.&lt;br&gt;PC4 · Anillos faltantes o perdidos: se pierde la venta." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="1250" height="110" as="geometry"/></mxCell><mxCell id="f1" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="s" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="t2" target="t4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="300"/></Array></mxGeometry></mxCell><mxCell id="f4" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="130"/></Array></mxGeometry></mxCell><mxCell id="f5" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="t5" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;"